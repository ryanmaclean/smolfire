# Per spec §11 (secrets handling): ephemeral envelope files MUST NOT be tracked
var/run/

# Operational spool and archives — may contain IPs, instance IDs, credentials,
# or other site-specific data.
var/mail/spool
var/mail/spool.*
var/mail/*.lock

# Per-task/global HALT envelopes — ephemeral FSM signaling
var/mail/HALT
var/mail/HALT.*

# Harvested build artifacts and reports
var/artifacts/
*.size-report.txt

# Build artifacts (large and reproducible)
build/
*.qcow2
*.raw
*.vmdk

# Temporary VM/build images
*.img
*.iso

# Claude Code agent worktrees and session data
.claude/

# Jujutsu metadata for colocated repositories
.jj/

# Editor / OS detritus
.DS_Store
*.swp
*.swo
*~

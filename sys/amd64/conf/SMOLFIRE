# SMOLFIRE — smolfire microVM kernel, rump-kernel spirit on FreeBSD:
# direct PVH kernel boot (Firecracker / QEMU microvm) with a static
# /rescue-based MFS root embedded IN the kernel. No bootloader, no ESP,
# no disk, no fsck — one ELF file is the whole OS.
#
# Base: releng/15.0 FIRECRACKER (standalone stripped conf: uart @0x3F8,
# virtio_mmio + vtnet + virtio_blk, ACPI runtime-disabled via
# hint.acpi.0.disabled, mptable CPU enumeration, PVH entry via XENHVM,
# and — critically — `options MD_ROOT` + `device md` already present).
#
# The MFS image is passed at build time, not in this file:
#   make buildkernel KERNCONF=SMOLFIRE MFS_IMAGE=/path/to/mfsroot.img
# kern.post.mk links it in via embedfs.S when MD_ROOT_SIZE is unset, and
# md(4) auto-mounts it: rootdevnames[0] = "ufs:/dev/md0" (md.c, MD_ROOT).
#
# SPDX-License-Identifier: Apache-2.0

include FIRECRACKER
ident SMOLFIRE

# RAM-backed scratch space for the live system (md root is small)
options TMPFS

# --- Production de-debug -------------------------------------------------
# Upstream releng/15.0 FIRECRACKER still carries GENERIC's -CURRENT debug
# block ("turn off in stable branch" — never done). Mirror what releng/15.0
# did to GENERIC + upstream sys/conf/std.nodebug: drop every runtime
# checker, keep KDB+KDB_TRACE+DDB so a panic still prints message +
# "KDB: stack backtrace:" on the serial gate (STACK is already in the
# base conf). config(8): nooptions removes at parse time, so this block
# must stay BELOW `include FIRECRACKER`.
nooptions 	INVARIANTS		# KASSERTs kernel-wide (~5-15% kernel-path CPU)
nooptions 	INVARIANT_SUPPORT	# only needed by INVARIANTS (no modules here)
nooptions 	WITNESS			# lock-order checker — the big boot-time cost
nooptions 	WITNESS_SKIPSPIN	# WITNESS modifier, inert without it
nooptions 	DEADLKRES		# deadlock-resolver kthread
nooptions 	BUF_TRACKING		# per-buf history
nooptions 	FULL_BUF_TRACKING	# more per-buf history
nooptions 	QUEUE_MACRO_DEBUG_TRASH	# stores on every queue unlink
nooptions 	MALLOC_DEBUG_MAXZONES	# collapse malloc(9) back to one zone
nooptions 	GDB			# remote gdb stub — sole uart is the console
nooptions 	NETGDB			# inert once GDB is gone (files: optional ... gdb)

#!/usr/bin/env nu
# SPDX-License-Identifier: Apache-2.0
# bin/attest-verify.nu — TPM 2.0 quote verifier for smolfire remote attestation.
#
# Validates a TPM quote generated by a smolfire guest. Expects:
#   - quote file: TOML with quote blob, PCR digest, signature, AK public key
#   - expected PCR digest (sha256 of PCR values)
#   - challenge nonce (anti-replay)
#
# Emits a structured [attestation] TOML block with verdict + evidence.
# Exit 0 on PASS, 1 on FAIL.
#
# Usage:
#   nu bin/attest-verify.nu --quote quote.toml --expected-pcr-digest <hex> --nonce <hex>
#   nu bin/attest-verify.nu --quote quote.toml --expected-pcr-digest-file pcr.hex --nonce-file nonce.hex
#
# Dependencies:
#   - openssl (for signature verification)
#   - tpm2-tools (optional, for tpm2_checkquote fallback)

# ── Logging ────────────────────────────────────────────────────────────────────

def log [msg: string] {
    print $"(date now | format date "%Y-%m-%dT%H:%M:%SZ") ($msg)"
}

# ── TOML quote file parser ─────────────────────────────────────────────────────

# Parse a quote TOML file and return a record with validated fields.
def parse-quote [path: string] {
    if not ($path | path exists) {
        error make {msg: $"quote file not found: ($path)"}
    }

    let data = open --raw $path | from toml

    # Required fields
    let required = [quote_data, pcr_digest, signature, ak_public, nonce, task_id]
    for field in $required {
        if ($field not-in $data) {
            error make {msg: $"quote file missing required field: ($field)"}
        }
    }

    $data
}

# ── Signature verification ───────────────────────────────────────────────────

# Verify quote signature using AK public key.
# Returns true if signature is valid, false otherwise.
def verify-signature [
    quote_data: string    # base64-encoded quote
    signature: string     # base64-encoded signature
    ak_public: string     # base64-encoded AK public key
] {
    # Write temporary files for openssl
    let tmpdir = ^mktemp -d | str trim
    let quote_file = $"($tmpdir)/quote.dat"
    let sig_file = $"($tmpdir)/quote.sig"
    let ak_file = $"($tmpdir)/ak.pub"

    # Decode base64
    (echo $quote_data | ^base64 -d | save --force $quote_file)
    (echo $signature | ^base64 -d | save --force $sig_file)
    (echo $ak_public | ^base64 -d | save --force $ak_file)

    # Try tpm2-tools first (proper TPM quote verification)
    let tpm2_check = (which tpm2_checkquote | is-not-empty)
    let verified = if $tpm2_check {
        verify-with-tpm2-tools $quote_file $sig_file $ak_file
    } else {
        # Fallback: openssl RSA signature verification
        verify-with-openssl $quote_file $sig_file $ak_file
    }

    # Cleanup
    ^rm -rf $tmpdir

    $verified
}

# Verify using tpm2_checkquote if available.
def verify-with-tpm2-tools [quote_file: string, sig_file: string, ak_file: string] {
    # Create temporary TSS context files
    let tmpdir = ^mktemp -d | str trim
    let result = try {
        # tpm2_checkquote requires specific file formats
        # For now, return false to trigger openssl fallback
        false
    } catch { false }

    ^rm -rf $tmpdir
    $result
}

# Verify using openssl RSA-PSS signature.
def verify-with-openssl [quote_file: string, sig_file: string, ak_file: string] {
    let result = try {
        # Convert AK public to PEM if needed
        let pem_file = $"($ak_file).pem"
        let convert = (^openssl rsa -pubin -in $ak_file -inform DER -out $pem_file -outform PEM 2>/dev/null | complete)

        if $convert.exit_code != 0 {
            # Try reading as PEM directly
            cp $ak_file $pem_file
        }

        # Verify signature
        let verify = (^openssl dgst -sha256 -verify $pem_file -signature $sig_file $quote_file e> /dev/null | complete)
        ($verify.exit_code == 0) and ($verify.stdout | str trim) == "Verified OK"
    } catch { false }

    $result
}

# ── PCR digest verification ──────────────────────────────────────────────────

# Verify that the PCR digest in the quote matches expected digest.
def verify-pcr-digest [quote_pcr: string, expected_pcr: string] {
    let q = $quote_pcr | str lowercase | str trim
    let e = $expected_pcr | str lowercase | str trim
    $q == $e
}

# ── Nonce verification ───────────────────────────────────────────────────────

# Verify anti-replay nonce matches challenge.
def verify-nonce [quote_nonce: string, challenge_nonce: string] {
    let q = $quote_nonce | str lowercase | str trim
    let c = $challenge_nonce | str lowercase | str trim
    $q == $c
}

# ── Attestation envelope ─────────────────────────────────────────────────────

# Emit structured [attestation] TOML block.
def emit-attestation [
    verdict: string       # "PASS" | "FAIL"
    task_id: string
    pcr_digest_match: bool
    signature_valid: bool
    nonce_match: bool
    pcr_digest: string
    nonce: string
    ak_fingerprint: string
    reason: string = ""
] {
    let ts = date now | format date "%Y-%m-%dT%H:%M:%SZ"

    print ""
    print "[attestation]"
    print $"verdict = \"($verdict)\""
    print $"task_id = \"($task_id)\""
    print $"timestamp = \"($ts)\""
    print $"pcr_digest_match = ($pcr_digest_match)"
    print $"signature_valid = ($signature_valid)"
    print $"nonce_match = ($nonce_match)"
    print $"pcr_digest = \"($pcr_digest)\""
    print $"nonce = \"($nonce)\""
    print $"ak_fingerprint = \"($ak_fingerprint)\""
    if $reason != "" {
        print $"reason = \"($reason)\""
    }
    print ""
}

# ── Main ───────────────────────────────────────────────────────────────────────

# Compute SHA-256 fingerprint of AK public key.
def ak-fingerprint [ak_public_b64: string] {
    try {
        let fp = (echo $ak_public_b64 | ^base64 -d | ^openssl dgst -sha256 -binary | ^openssl enc -hex 2>/dev/null | str trim)
        $fp
    } catch { "unknown" }
}

# ── CLI ──────────────────────────────────────────────────────────────────────

def main [
    --quote: string = ""                    # Path to quote TOML file
    --expected-pcr-digest: string = ""       # Expected PCR digest (hex)
    --expected-pcr-digest-file: string = ""  # File with expected PCR digest
    --nonce: string = ""                     # Challenge nonce (hex)
    --nonce-file: string = ""               # File with challenge nonce
] {
    # Validate inputs
    if $quote == "" {
        print "Usage: nu bin/attest-verify.nu --quote <file> --expected-pcr-digest <hex> --nonce <hex>"
        print "       nu bin/attest-verify.nu --quote <file> --expected-pcr-digest-file <file> --nonce-file <file>"
        exit 1
    }

    # Resolve expected PCR digest
    let expected_pcr = if $expected_pcr_digest_file != "" {
        open --raw $expected_pcr_digest_file | str trim | str lowercase
    } else {
        $expected_pcr_digest | str trim | str lowercase
    }

    # Resolve nonce
    let challenge_nonce = if $nonce_file != "" {
        open --raw $nonce_file | str trim | str lowercase
    } else {
        $nonce | str trim | str lowercase
    }

    if $expected_pcr == "" {
        print "ERROR: expected PCR digest required"
        exit 1
    }
    if $challenge_nonce == "" {
        print "ERROR: challenge nonce required"
        exit 1
    }

    log $"verifier: loading quote from ($quote)"

    # Parse quote file
    let quote_data = try { parse-quote $quote } catch {|err|
        print $"ERROR: ($err.msg)"
        emit-attestation "FAIL" "" false false false "" "" "" $err.msg
        exit 1
    }

    let task_id = $quote_data.task_id
    log $"verifier: task_id=($task_id)"

    # Verify PCR digest
    let pcr_match = verify-pcr-digest $quote_data.pcr_digest $expected_pcr
    log $"verifier: PCR digest match=($pcr_match)"

    # Verify nonce
    let nonce_match = verify-nonce $quote_data.nonce $challenge_nonce
    log $"verifier: nonce match=($nonce_match)"

    # Verify signature
    let sig_valid = verify-signature $quote_data.quote_data $quote_data.signature $quote_data.ak_public
    log $"verifier: signature valid=($sig_valid)"

    # Compute AK fingerprint
    let fp = ak-fingerprint $quote_data.ak_public

    # Determine verdict
    let all_pass = $pcr_match and $nonce_match and $sig_valid
    let verdict = if $all_pass { "PASS" } else { "FAIL" }

    let reason = if not $all_pass {
        let failures = []
        let failures = (if not $pcr_match { $failures | append "PCR digest mismatch" } else { $failures })
        let failures = (if not $nonce_match { $failures | append "nonce mismatch" } else { $failures })
        let failures = (if not $sig_valid { $failures | append "signature verification failed" } else { $failures })
        $failures | str join "; "
    } else { "" }

    log $"verifier: verdict=($verdict)"

    emit-attestation $verdict $task_id $pcr_match $sig_valid $nonce_match $quote_data.pcr_digest $quote_data.nonce $fp $reason

    if $all_pass { exit 0 } else { exit 1 }
}

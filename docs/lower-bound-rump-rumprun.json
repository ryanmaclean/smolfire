      "code_surface": "unikernel image plus a tiny worker; no conventional BSD userspace inside the guest",
      "build": {
        "upstream_repo": "https://github.com/rumpkernel/rumprun",
        "target": "hw_virtio",
        "state_disk_format": "raw",
        "state_disk_size_bytes": 67108864,
        "commands": [
          "git clone https://github.com/rumpkernel/rumprun",
          "cd rumprun && ./build-rr.sh hw_virtio",
          "x86_64-rumprun-netbsd-gcc -O2 -o worker worker.c",
          "rumprun-bake hw_virtio worker.bin worker",
          "truncate -s 64M state.img",
          "vnconfig vnd0 state.img && disklabel -I -r vnd0 && newfs /dev/rvnd0a && vnconfig -u vnd0"
        ]
      },
      "workload": {
        "ready_marker": "SMOLFIRE_READY",
        "smoke_steps": [
          "mount the virtio-backed FFS state disk read-write",
          "run the BOP state workload",
          "emit SMOLFIRE_READY on serial after the disk is mounted and the worker is ready"
